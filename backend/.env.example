# Copy to .env and edit. Never commit .env.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/iem_admission
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/iem_admission_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:4200
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152
# Initial admin created by `npm run seed`
ADMIN_NAME=POC Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
